{
  "expo": {
    "name": "TrajetMada",
    "slug": "trajet-mada",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.trajetmada.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "TrajetMada",
        "CFBundleDevelopmentRegion": "fr",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.trajetmada.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0E5F59"
        }
      ]
    ]
  }
}
